{
  "name": "@chovizzz/agent-kit",
  "version": "0.1.0",
  "description": "Rules, skills and subagent definitions for coding agents: one neutral source, rendered per agent.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-kit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && node scripts/gen-third-party-licenses.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "golden:update": "vitest run test/golden -u",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:payload": "node scripts/build-payload.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs --freeze-only"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "sigstore": "5.0.0",
    "smol-toml": "1.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "files": [
    "dist/",
    "payload/",
    "integrity.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chovizzz/agent-kit.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
