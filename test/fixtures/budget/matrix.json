{
  "$comment": "A2 的 12 格矩阵(limit_source x enforce x 超/不超)。exit = check 退出码;diagnostic = 期望出现的告警(null 表示不应出现任何 BUDGET_ 诊断)。assumed 不论 enforce 都只告警、退出 0(设计 3.6 硬规则)。",
  "cells": [
    {
      "limit_source": "documented",
      "enforce": "warn",
      "over": true,
      "exit": 0,
      "diagnostic": { "code": "BUDGET_OVER_LIMIT", "severity": "warn" }
    },
    {
      "limit_source": "documented",
      "enforce": "warn",
      "over": false,
      "exit": 0,
      "diagnostic": null
    },
    {
      "limit_source": "documented",
      "enforce": "block",
      "over": true,
      "exit": 1,
      "diagnostic": { "code": "BUDGET_OVER_LIMIT", "severity": "error" }
    },
    {
      "limit_source": "documented",
      "enforce": "block",
      "over": false,
      "exit": 0,
      "diagnostic": null
    },
    {
      "limit_source": "probed",
      "enforce": "warn",
      "over": true,
      "exit": 0,
      "diagnostic": { "code": "BUDGET_OVER_LIMIT", "severity": "warn" }
    },
    { "limit_source": "probed", "enforce": "warn", "over": false, "exit": 0, "diagnostic": null },
    {
      "limit_source": "probed",
      "enforce": "block",
      "over": true,
      "exit": 1,
      "diagnostic": { "code": "BUDGET_OVER_LIMIT", "severity": "error" }
    },
    { "limit_source": "probed", "enforce": "block", "over": false, "exit": 0, "diagnostic": null },
    {
      "limit_source": "assumed",
      "enforce": "warn",
      "over": true,
      "exit": 0,
      "diagnostic": { "code": "BUDGET_OVER_LIMIT", "severity": "warn" }
    },
    { "limit_source": "assumed", "enforce": "warn", "over": false, "exit": 0, "diagnostic": null },
    {
      "limit_source": "assumed",
      "enforce": "block",
      "over": true,
      "exit": 0,
      "diagnostic": { "code": "BUDGET_OVER_LIMIT", "severity": "warn" }
    },
    { "limit_source": "assumed", "enforce": "block", "over": false, "exit": 0, "diagnostic": null }
  ]
}
